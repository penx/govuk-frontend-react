{
  "name": "govuk-frontend-react",
  "version": "1.0.0-alpha.3",
  "description": "A direct port of govuk-frontend to React components, with HTML output that matches govuk-frontend",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run tests/parity.test.tsx --reporter=verbose",
    "prepublishOnly": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/penx/govuk-frontend-react.git"
  },
  "keywords": [
    "govuk",
    "govuk-frontend",
    "react"
  ],
  "author": "Alasdair McLeay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/penx/govuk-frontend-react/issues"
  },
  "homepage": "https://github.com/penx/govuk-frontend-react#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "govuk-frontend": "~6.6.0",
    "react": ">=19"
  },
  "dependencies": {
    "@govuk-react/icon-crown": "^0.2.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.14.4",
    "domhandler": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "govuk-frontend": "6.6.0",
    "html-react-parser": "^6.1.9",
    "htmlparser2": "^12.0.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "nunjucks": "^3.2.4",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "storybook": "^10.6.7",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
